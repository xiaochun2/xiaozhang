              "type": "boolean"
            },
            "review_state": {
              "description": "备案资料总审核状态；不代替 filing_state 或 icp_state",
              "type": "string"
            },
            "scene": {
              "description": "备案场景：filing_scene_h5_game 为 H5 游戏备案；filing_scene_default 为普通备案",
              "type": "string"
            },
            "self_icp_pre_approval_ready": {
              "description": "自身 ICP 适用前置资料是否就绪，不代表 ICP 已通过，也不能单独作为 H5 游戏备案提审失败原因",
              "type": "boolean"
            },
            "snapshot": {
              "type": "string"
            },
            "version_id": {
              "description": "当前备案记录关联的包体版本，不一定等于应用当前绑定的主包体版本",
              "format": "int64",
              "type": "integer"
