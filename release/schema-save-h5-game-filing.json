      "properties": {
        "app_id": {
          "description": "游戏 ID",
          "format": "int64",
          "type": "integer"
        },
        "developer_id": {
          "description": "厂商 ID",
          "format": "int64",
          "type": "integer"
        },
        "expected_snapshot": {
          "minLength": 1,
          "type": "string"
        },
        "game_introduction": {
          "maxLength": 100,
          "type": "string"
