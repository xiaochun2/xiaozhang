      "properties": {
        "result": {
          "properties": {
            "filing_id": {
              "format": "int64",
              "type": "integer"
            },
            "filing_state": {
              "description": "游戏备案进度；备案完成不代表游戏自身 ICP 已通过",
              "type": "string"
            },
            "icp_state": {
              "description": "游戏自身 ICP 独立进度；icp_status_not_required 表示未启用，不等于已通过或永久免办；icp_status_unspecified 表示状态未确认",
              "type": "string"
            },
            "record_exists": {
              "type": "boolean"
            },
            "requires_sms_verification": {
